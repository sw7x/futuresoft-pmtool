{
    "name": "futuresoft/messaging-module",
    "description": "This laravel module handles sending and reciving messages among the users in futuresoft PVT LTD",
    "type": "laravel-module",
    "autoload": {
        "psr-4": {
            "Modules\\Messaging\\": "src/",
            "Modules\\Messaging\\Database\\Seeders\\": "database/seeders/",
            "Modules\\Messaging\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Modules\\Messaging\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Modules\\Messaging\\Providers\\MessagingServiceProvider"
            ]
        }
    }
}