{
    "name": "futuresoft/designation-module",
    "description": "This laravel module handles the designations of the users in futuresoft PVT LTD",
    "type": "library",
    "autoload": {
        "psr-4": {
            "Modules\\Designation\\": "src/",
            "Modules\\Designation\\Database\\Seeders\\": "database/seeders/",
            "Modules\\Designation\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Modules\\Designation\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Modules\\Designation\\Providers\\DesignationServiceProvider"
            ]
        }
    }
}