{
    "name": "futuresoft/project-progress-tracking-module",
    "description": "This laravel module track progress of the projects in futuresoft PVT LTD",
    "type": "library",
    "autoload": {
        "psr-4": {
            "Modules\\ProjectProgressTracking\\": "src/",
            "Modules\\ProjectProgressTracking\\Database\\Seeders\\": "database/seeders/",
            "Modules\\ProjectProgressTracking\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Modules\\ProjectProgressTracking\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Modules\\ProjectProgressTracking\\Providers\\ProjectProgressTrackingServiceProvider"
            ]
        }
    }
}